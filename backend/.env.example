APP_NAME=ResellSeba
APP_ENV=production
APP_KEY=base64:LcRhL5rrKr1x61LgMWzd05ZM1T6jEMJn5gJ+MQrlaLw=
APP_DEBUG=false
APP_TIMEZONE=Asia/Dhaka

# -------------------------------------------------------------
# 1. SINGLE DOMAIN SETUP (petzavo.com - NO SUBDOMAIN NEEDED!)
# -------------------------------------------------------------
APP_URL=https://petzavo.com
FRONTEND_URL=https://petzavo.com
SANCTUM_STATEFUL_DOMAINS=petzavo.com,www.petzavo.com
CORS_ALLOWED_ORIGINS=https://petzavo.com,https://www.petzavo.com

ASSET_URL=null
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# -------------------------------------------------------------
# 2. DATABASE CONFIGURATION (cPanel MySQL)
# >>> CHANGE ONLY DB_USERNAME and DB_PASSWORD in cPanel <<<
# -------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zhroni367_resellseba_site
DB_USERNAME=zhroni367_dbuser
DB_PASSWORD=YOUR_DB_PASSWORD_HERE

BROADCAST_CONNECTION=log
CACHE_STORE=file
CACHE_PREFIX=
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# -------------------------------------------------------------
# 3. MAIL CONFIGURATION (Optional)
# -------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="support@petzavo.com"
MAIL_FROM_NAME="${APP_NAME}"

# -------------------------------------------------------------
# 4. COURIER APIS (Optional)
# -------------------------------------------------------------
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=

CARRYBEE_API_KEY=

# -------------------------------------------------------------
# 5. PAYMENT GATEWAYS (Optional)
# -------------------------------------------------------------
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=false

BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
